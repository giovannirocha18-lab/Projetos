# Site em construção: pede aos buscadores para não indexar nenhuma página.
# Apagar esta regra no lançamento.
/*
  X-Robots-Tag: noindex, nofollow

# /assets/ e /marca/ saem direto do Cloudflare, sem passar pelo functions/_middleware.js (ver _routes.json):
# os cabeçalhos de segurança deles ficam aqui. As páginas e a API recebem os seus no _middleware.js.
/assets/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'

/marca/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'

# Fonte do site: o arquivo não muda, o navegador pode guardar por 1 ano
/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
